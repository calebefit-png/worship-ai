{
  "name": "worship-ai-backend",
  "version": "1.0.0",
  "description": "Backend para separação de áudio (estilo Moises)",
  "main": "server/server.js",
  "scripts": {
    "prepare-model": "python3 -m pip install --user --break-system-packages --disable-pip-version-check onnx==1.22.0 onnxruntime==1.28.0 && python3 scripts/prepare-int8-model.py",
    "postinstall": "npm run prepare-model",
    "start": "node --expose-gc --max-old-space-size=128 server/server.js",
    "dev": "node --expose-gc --max-old-space-size=128 node_modules/nodemon/bin/nodemon.js server/server.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "onnxruntime-node": "^1.27.0",
    "sqlite3": "^5.1.7",
    "uuid": "^10.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
